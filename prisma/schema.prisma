// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum TransactionType {
  INFLOW
  OUTFLOW
}

enum PaymentMethod {
  PIX
  CREDIT
  DEBIT
  CASH
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum CommissionStatus {
  PENDING
  PAID
  REJECTED
}

enum AutomationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum ExceptionType {
  HOLIDAY
  DAY_OFF
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  role         Role          @default(ADMIN)
  companyId    String?
  company      Company?      @relation(fields: [companyId], references: [id])
  staff        Staff?
  appointments Appointment[]
  cashRegisters CashRegister[] @relation("OperatorRegisters")
}

model Company {
  id             String           @id @default(uuid())
  slug           String           @unique
  name           String
  address        String?
  phone          String?
  email          String?
  users          User[]
  clients        Client[]
  services       Service[]
  appointments   Appointment[]
  expenses       Expense[]
  stock          Stock[]
  staff          Staff[]
  cashRegisters  CashRegister[]
  transactions   Transaction[]
  commissions    Commission[]
  automationJobs AutomationJob[]
  automationLogs  AutomationLog[]
  exceptions     CompanyException[]
  subscription   CompanySubscription?
}

model CompanySubscription {
  id        String             @id @default(cuid())
  companyId String             @unique
  status    SubscriptionStatus @default(TRIAL)
  planName  String             @default("PRO")
  expiresAt DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CompanyException {
  id             String        @id @default(uuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  professionalId String?
  date           DateTime
  reason         String
  type           ExceptionType
  createdAt      DateTime      @default(now())

  @@index([companyId, date])
  @@index([professionalId, date])
}

model Client {
  id          String        @id @default(uuid())
  companyId   String?
  company     Company?      @relation(fields: [companyId], references: [id])
  name        String
  phone       String?
  email       String?
  appointments Appointment[]
}

model Service {
  id          String        @id @default(uuid())
  companyId   String?
  company     Company?      @relation(fields: [companyId], references: [id])
  name        String
  price       Float
  cost        Float?
  duration    Int?
  appointments Appointment[]
}

model Staff {
  id             String      @id @default(uuid())
  userId         String?     @unique
  user           User?       @relation(fields: [userId], references: [id])
  companyId      String?
  company        Company?    @relation(fields: [companyId], references: [id])
  name           String
  commissionRate Float       @default(0)
  customHours    Json?
  appointments   Appointment[]
  commissions    Commission[]
}

model Appointment {
  id            String     @id @default(uuid())
  date          DateTime
  clientId      String
  serviceId     String
  userId        String?
  staffId       String?
  companyId     String?
  status        String
  price         Float?

  client        Client     @relation(fields: [clientId], references: [id])
  service       Service    @relation(fields: [serviceId], references: [id])
  user          User?      @relation(fields: [userId], references: [id])
  staff         Staff?     @relation(fields: [staffId], references: [id])
  company       Company?   @relation(fields: [companyId], references: [id])
  transaction   Transaction? 
  commission    Commission?
  automationLogs AutomationLog[]
}

model Expense {
  id          String   @id @default(uuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  description String
  amount      Float
  date        DateTime
  category    String?
  transaction Transaction?
}

model Stock {
  id          String   @id @default(uuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  name        String
  quantity    Int
  minQuantity Int?
  price       Float?
}

model CashRegister {
  id           String              @id @default(uuid())
  status       CashRegisterStatus  @default(OPEN)
  openedAt     DateTime            @default(now())
  closedAt     DateTime?
  initialValue Float
  finalValue   Float?
  operatorId   String
  companyId    String?
  operator     User                @relation("OperatorRegisters", fields: [operatorId], references: [id])
  company      Company?            @relation(fields: [companyId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id             String            @id @default(uuid())
  type           TransactionType
  amount         Float
  paymentMethod  PaymentMethod
  status         TransactionStatus @default(PENDING)
  appointmentId  String?           @unique
  expenseId      String?           @unique
  cashRegisterId String?
  companyId      String?
  createdAt      DateTime          @default(now())

  appointment    Appointment?      @relation(fields: [appointmentId], references: [id])
  expense        Expense?          @relation(fields: [expenseId], references: [id])
  cashRegister   CashRegister?     @relation(fields: [cashRegisterId], references: [id])
  company        Company?          @relation(fields: [companyId], references: [id])
}

model Commission {
  id            String            @id @default(uuid())
  staffId       String
  appointmentId String            @unique
  companyId     String?
  amount        Float
  status        CommissionStatus  @default(PENDING)
  createdAt     DateTime          @default(now())

  staff         Staff             @relation(fields: [staffId], references: [id])
  appointment   Appointment       @relation(fields: [appointmentId], references: [id])
  company       Company?          @relation(fields: [companyId], references: [id])
}

model AutomationJob {
  id           String              @id @default(uuid())
  type         String
  payload      Json
  scheduledFor DateTime
  status       AutomationJobStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  companyId    String?
  company      Company?          @relation(fields: [companyId], references: [id])
}

model AutomationLog {
  id           String    @id @default(uuid())
  companyId    String?
  appointmentId String?
  actionType   String
  payload      Json
  result       Json?
  status       AutomationJobStatus @default(PENDING)
  createdAt    DateTime  @default(now())

  company      Company?  @relation(fields: [companyId], references: [id])
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
  @@index([companyId])
  @@index([appointmentId])
}
